{
  "name": "hobbymate-backend",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "start": "SET NODE_ENV=production && node src/index.js",
    "dev": "SET NODE_ENV=production && node --watch src/index.js",
    "lint": "eslint src/**/*.js --quiet --fix",
    "release": "standard-version && git push --follow-tags --no-verify",
    "prepare": "husky",
    "pre-commit": "npm run lint",
    "pre-push": "npm run release"
  },
  "keywords": [
    "hobbymate",
    "backend"
  ],
  "author": "FeryaelJustice",
  "license": "ISC",
  "description": "HobbyMate backend",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "eslint": "^9.15.0",
    "husky": "^9.1.7",
    "standard-version": "^9.5.0"
  }
}
